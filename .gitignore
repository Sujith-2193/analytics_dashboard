# Build outputs
dist/
build/
*.egg-info/

# The production bundle Flask serves. Generated by `npm run build` and copied
# here, so it is build output rather than source. It was tracked until 2026-08-09,
# which meant the committed bundle drifted out of sync with the code that
# produced it and every rebuild wrote a new 700 KB blob into history.
backend/static/

# Agent tool settings. Machine-local, and no business being in a public repo.
# Previously covered only by a global gitignore, which protects one machine
# rather than the repository.
.claude/settings.local.json

