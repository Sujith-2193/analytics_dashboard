# Response headers for the hosted static demo.
#
# No Content-Security-Policy here on purpose: the chart library sets inline
# styles for positioning, so a policy tight enough to be worth having would
# need 'unsafe-inline' and would then not be worth having. The headers below
# are the ones that cost nothing and still matter for a public page.
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()

# Vite fingerprints these filenames, so the content at a given URL never
# changes and a long immutable cache is safe.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# The snapshot is regenerated by a rebuild, and its filenames are stable rather
# than fingerprinted. Revalidate so a fresh snapshot is not masked by the edge.
/data/*
  Cache-Control: public, max-age=300, must-revalidate
